@page "/register"
@page "/register/{EventId:int}"
@using System.ComponentModel.DataAnnotations
@using EventEase.Services
@inject EventEase.Services.UserSessionState Session

<h1>Event Registration</h1>

@if (selectedEvent is null)
{
    <p>@(EventId.HasValue ? "Event not found. Please choose an event." : "Choose an event to register for.")</p>
    <ul>
        @foreach (var eventItem in EventCatalog.Events)
        {
            <li @key="eventItem.Id">
                <a href="@($"/register/{eventItem.Id}")">@eventItem.Name</a>
            </li>
        }
    </ul>
}
else
{
<h2>Register for @selectedEvent.Name</h2>

<p>Please enter your details to register for this event.</p>

<EditForm Model="model" OnValidSubmit="Register" FormName="registration" novalidate>
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="name" class="form-label">Name:</label>
        <InputText id="name" class="form-control" @bind-Value="model.Name"
                   autocomplete="name" maxlength="100" />
        <ValidationMessage For="@(() => model.Name)" />
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">Email:</label>
        <InputText id="email" type="email" class="form-control"
                   @bind-Value="model.Email" autocomplete="email" maxlength="254" />
        <ValidationMessage For="@(() => model.Email)" />
    </div>

    <button type="submit" class="btn btn-primary">Register</button>
</EditForm>

@if (submitted)
{
    <p role="status">Thank you, @Session.Name! Your registration for @selectedEvent.Name has been received.</p>
}
}

<p class="mt-3"><a href="/attendance">View Attendance</a></p>
<p><a href="/events">Back to Events</a></p>

@code {
    [Parameter]
    public int? EventId { get; set; }

    private EventItem? selectedEvent;
    private readonly RegistrationInput model = new();
    private bool submitted;

    protected override void OnInitialized()
    {
        model.Name = Session.Name;
        model.Email = Session.Email;
    }

    protected override void OnParametersSet()
    {
        selectedEvent = EventCatalog.Find(EventId);
        submitted = false;
    }

    private void Register()
    {
        if (selectedEvent is null)
        {
            return;
        }

        Session.Register(model.Name, model.Email, selectedEvent.Name);
        submitted = true;
    }

    public sealed class RegistrationInput
    {
        [Required(ErrorMessage = "Please enter your name.")]
        [StringLength(100, ErrorMessage = "Use 100 characters or fewer for your name.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        [StringLength(254, ErrorMessage = "Use 254 characters or fewer for your email.")]
        public string Email { get; set; } = "";
    }
}